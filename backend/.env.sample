# Local dev: copy to backend/.env and fill in.
# On Railway: set these as service Variables instead (do NOT commit real keys).

# Testing switch. Default 0 = NO mock: a missing key or a failed live call raises
# a real error instead of returning fabricated demo numbers. Set to 1 to restore
# the no-key demo fallback.
ALLOW_MOCK=0

# Timeouts. Kimi K2.6 is a reasoning model — it can take minutes per run, so
# both are generous. CHAT_TIMEOUT = per-call read timeout (seconds). RUN_DEADLINE
# = whole-run / whole-Compare budget; any engine still going past it is marked
# "exceeded the time budget". Raise if Kimi still times out on your cases.
CHAT_TIMEOUT=240
RUN_DEADLINE=420

# Retry policy for rate limits (429) and transient upstream errors. Five
# dimension agents fire concurrently per engine — fifteen in Compare — which is
# a burst big enough to trip a provider's per-minute limit. Retries use
# exponential backoff with jitter and honour a Retry-After header.
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY=2
RETRY_MAX_DELAY=30

# Cap concurrent in-flight calls PER PROVIDER. Lower this if one provider keeps
# returning 429 — it prevents the burst rather than recovering from it. OpenAI
# tiers are the usual culprit because GPT-5.5 carries the largest prompts.
MAX_INFLIGHT_PER_PROVIDER=3

# ---- Evidence thresholds -------------------------------------------------
# These govern when the pipeline REFUSES to produce a number. A dimension the
# model could not actually see used to be forced to return an integer, and that
# fabricated value was averaged into the composite.
#
# MIN_DIM_CONFIDENCE: a dimension scored below this self-reported confidence is
#   treated as a guess and abstained rather than folded into the composite.
# MIN_ASSESSED_DIMS: how many of the 5 dimensions must actually be assessed
#   before a composite score is emitted at all. Below it the run returns
#   "Insufficient Evidence — Recapture" with no score.
# REQUIRE_LABEL_FOR_VERDICT: 1 = a run that could not read the label is capped
#   at Inconclusive and cannot conclude counterfeit.
# PAIRING_MIN_CONFIDENCE: how sure the pre-flight pairing check must be that
#   suspect and reference are different products before it voids the run.
# VERIFY_VOTES: independent adversarial verify calls per verdict, tallied
#   server-side. 1 restores the old single-call behaviour (cheaper, weaker).
# RN_LOOKUP: resolve the RN on a care label against the live FTC registry
#   (https://www.ftc.gov/rn-database/search — public, no key). Results are cached
#   for 30 days and seeded with the known VF RNs, so turning this off only loses
#   resolution of RNs outside the seed table. An unreachable registry always
#   reports UNKNOWN and never manufactures a counterfeit indicator.
RN_LOOKUP=1
RN_LOOKUP_TIMEOUT=8

# ALWAYS_SCORE=1 fills EVERY dimension cell with a number, even where the
#   evidence does not support one. The model supplies a low-confidence best
#   estimate; the cell is marked status="estimated" (italic amber in the export)
#   and "Assessed n/5" still counts only the evidence-backed dimensions, so a
#   populated grid never claims to be a fully measured one.
#   Set to 0 for honest abstention — those cells read "n/a" instead.
ALWAYS_SCORE=1

MIN_DIM_CONFIDENCE=0.35
MIN_ASSESSED_DIMS=3
REQUIRE_LABEL_FOR_VERDICT=1
PAIRING_MIN_CONFIDENCE=0.7
VERIFY_VOTES=3

# OpenAI engine (toggle: "OpenAI · GPT-5.5")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Gemini engine via OpenRouter (toggle: "Gemini 3.1 Pro · OpenRouter")
OPENROUTER_API_KEY=
GEMINI_OR_MODEL=google/gemini-3.1-pro-preview

# Kimi (Moonshot) challenger engine (toggle: "Kimi ...").
# Default routing is OpenRouter; KIMI_API_KEY falls back to OPENROUTER_API_KEY if blank.
# kimi-k2.6 is the current native-multimodal (vision) flagship — needed because the
# dimension agents send images. (kimi-latest was discontinued 2026-01-28.)
# To hit Moonshot directly instead: set
#   KIMI_BASE=https://api.moonshot.ai/v1  and  KIMI_MODEL=kimi-k2.6
KIMI_API_KEY=
KIMI_BASE=https://openrouter.ai/api/v1
KIMI_MODEL=moonshotai/kimi-k2.6

# Google reverse-image references via SerpAPI (toggle: "References: Google reverse")
SERPAPI_API_KEY=
SERPAPI_COST_PER_SEARCH=0

# Supabase product catalog (uses a dedicated bucket; does not touch existing data)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=veritas-products
